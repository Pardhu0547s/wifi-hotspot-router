<?xml version="1.0" encoding="utf-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.wifi-hotspot-router" path="/org/gnome/shell/extensions/wifi-hotspot-router/">
    <key name="hotspot-ssid" type="s">
      <default>'hotspot'</default>
      <summary>Hotspot SSID</summary>
    </key>
    <key name="use-password" type="b">
      <default>true</default>
      <summary>Toggle Password Security Mode</summary>
    </key>
    <key name="max-clients" type="i">
      <default>10</default>
      <summary>Maximum Client Connections Limit</summary>
    </key>
    <key name="hotspot-band" type="s">
      <default>'bg'</default>
      <summary>Wi-Fi Band Selection</summary>
      <description>Choose 'bg' for 2.4 GHz or 'a' for 5 GHz</description>
    </key>
    <key name="dns-profile" type="s">
      <default>'system'</default>
      <summary>DNS and Ad-Blocking Profile</summary>
      <description>Options: system, cloudflare, adguard, quad9, google</description>
    </key>
    <key name="security-mode" type="s">
      <default>'wpa2'</default>
      <summary>Security Encryption Mode</summary>
      <description>Options: wpa2, wpa3-mixed, wpa3</description>
    </key>
    <key name="isolate-clients" type="b">
      <default>false</default>
      <summary>Client Isolation Mode</summary>
      <description>Prevent connected stations from communicating directly</description>
    </key>
    <key name="idle-timeout" type="i">
      <default>0</default>
      <summary>Auto-Turn Off Idle Timeout in Minutes</summary>
      <description>0 means disabled; 10, 15, 30 minutes</description>
    </key>
    <key name="inhibit-sleep" type="b">
      <default>false</default>
      <summary>Prevent System Sleep While Hotspot Is Active</summary>
      <description>Inhibit laptop suspend when devices are connected</description>
    </key>
  </schema>
</schemalist>
