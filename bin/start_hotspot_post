#!/bin/bash

IP_BIN=$(command -v ip || echo "/usr/bin/ip")
IW_BIN=$(command -v iw || echo "/usr/sbin/iw")

AP_DEV="ap0"
HOSTAPD_CONF=$(ls -t /tmp/create_ap.*/hostapd.conf 2>/dev/null | head -1)
if [ -n "$HOSTAPD_CONF" ] && [ -f "$HOSTAPD_CONF" ]; then
    CONF_IFACE=$(grep -E '^interface=' "$HOSTAPD_CONF" 2>/dev/null | cut -d= -f2 | tr -d ' \r\n')
    [ -n "$CONF_IFACE" ] && AP_DEV="$CONF_IFACE"
fi

if [ -x "$IP_BIN" ]; then
    for _ in $(seq 1 30); do
        if $IP_BIN addr show dev "$AP_DEV" 2>/dev/null | grep -q "inet "; then
            break
        fi
        sleep 0.5
    done

    $IP_BIN link set dev "$AP_DEV" txqueuelen 5000 2>/dev/null || true
fi

if [ -x "$IW_BIN" ]; then
    for w in $($IW_BIN dev 2>/dev/null | awk '$1=="Interface"{print $2}'); do
        $IW_BIN dev "$w" set power_save off 2>/dev/null || true
    done
fi

IPTABLES_BIN=$(command -v iptables || echo "/usr/sbin/iptables")
if [ -x "$IPTABLES_BIN" ]; then
    while $IPTABLES_BIN -w -D FORWARD -i "$AP_DEV" -p tcp -m multiport --dports 8090,8092 -j REJECT --reject-with tcp-reset 2>/dev/null; do :; done
    $IPTABLES_BIN -w -I FORWARD 1 -i "$AP_DEV" -p tcp -m multiport --dports 8090,8092 -j REJECT --reject-with tcp-reset 2>/dev/null || true
fi
